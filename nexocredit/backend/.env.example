# Copiar a backend/.env.postgresql y sustituir la contraseña.
# El script scripts/postgresql-local.ps1 prepara esta configuración automáticamente.
DATABASE_URL=postgresql://pluri_app:CAMBIAR@127.0.0.1:55432/pluri_credito

# Variables de entorno del proceso backend; no ponerlas en VITE_* ni en Git.
# Azure sigue implementado. Conserva estos campos aunque uses proveedores locales.
# Guía: docs/manuales/AZURE_IMPLEMENTADO_Y_CONFIGURACION.md.
# Dejarlas vacías mantiene la demostración Azure deshabilitada.
AZURE_ML_SCORING_URI=
AZURE_ML_API_KEY=
AZURE_ML_MODEL_ID=

# Azure OpenAI: clave solo del backend, nunca VITE_*.
# Docker usa infraestructura/contenedores_docker/.env; ejecutar operacion/integraciones/Conectar Azure OpenAI.cmd.
AZURE_OPENAI_RESPONSES_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# Azure AI Search: servicio e índice de guías demo; llave de consulta, nunca admin.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_QUERY_KEY=

# Banxico SIE: token privado de consulta, solo backend. Banco Mundial no requiere token.
BANXICO_API_TOKEN=

# Para ejecutar sin Docker: variables privadas de autenticación/proveedores.
# Docker NO lee este archivo: usa infraestructura/contenedores_docker/.env.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_SECRET=
LOCAL_AUTH_TOKEN_SECONDS=1800
EXPLICACIONES_PROVEEDOR=azure
DOCUMENTOS_PROVEEDOR=azure
ML_PROVEEDOR=azure
# Alternativa sin suscripción: ML_PROVEEDOR=local usa el modelo UCI JSON incluido.
# deshabilitado impide explícitamente las consultas del laboratorio.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
