# ARCHIVO DE EJEMPLO: no pongas secretos reales aquí ni lo compartas con llaves.
# Edita el archivo privado .env de esta misma carpeta para configurar Docker.
# Azure sigue implementado aunque se seleccione modo local; conserva los campos AZURE_*.
# Guía: docs/manuales/AZURE_IMPLEMENTADO_Y_CONFIGURACION.md (sin secretos reales).
# El lanzador genera las contraseñas PostgreSQL la primera vez. NO las cambies
# después de crear el volumen: el archivo no cambia la contraseña de la base.
POSTGRES_ADMIN_PASSWORD=REEMPLAZAR
POSTGRES_APP_PASSWORD=REEMPLAZAR
WEB_PORT=8080

# ACCESO LOCAL adicional a Microsoft. Activar modo local genera el secreto aleatorio.
# No es la contraseña de ningún usuario. Nunca lo pongas en frontend ni VITE_*.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_SECRET=
LOCAL_AUTH_TOKEN_SECONDS=1800

# PROVEEDORES. Los valores predeterminados conservan las integraciones Azure.
# Sin Azure: explicaciones=ollama, documentos=local, ML=local (modelo UCI incluido).
# local en explicaciones usa una plantilla de reglas, NO IA generativa.
EXPLICACIONES_PROVEEDOR=azure
DOCUMENTOS_PROVEEDOR=azure
ML_PROVEEDOR=azure

# Valoración generativa de los mismos datos MXN; ollama o deshabilitado.
# Se genera automáticamente tras guardar, consume recursos locales y queda en caché 24 h.
# No cambia las reglas ni es una predicción estadística de incumplimiento.
VALORACION_IA_PROVEEDOR=ollama

# OLLAMA instalado en Windows: Docker accede al equipo por host.docker.internal.
# No requiere llave. Nombre exacto de un modelo ya instalado; no lo descarga.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# AZURE OPENAI: URL completa de Responses, implementación y llave privada.
# Aquí se pega únicamente el VALOR de la llave, no el nombre del encabezado.
AZURE_OPENAI_RESPONSES_URL=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# AZURE AI SEARCH: URL del servicio, índice y llave de CONSULTA (no admin).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_QUERY_KEY=

# AZURE ML: dirección del endpoint, identificador y llave privada.
# También se conservan con ML_PROVEEDOR=local; no borrarlos al cambiar de modo.
AZURE_ML_SCORING_URI=
AZURE_ML_MODEL_ID=
AZURE_ML_API_KEY=

# BANXICO: solo el valor del token SIE; no escribas "Bmx-Token:" ni "token=".
# Banco Mundial no necesita llave. Estas APIs no cambian el riesgo demo.
BANXICO_API_TOKEN=
