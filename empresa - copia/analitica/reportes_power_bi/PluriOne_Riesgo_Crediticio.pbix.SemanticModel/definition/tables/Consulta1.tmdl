table Consulta1
	lineageTag: 207a6f65-672d-4cbf-9cc0-99ac461e8610

	measure 'Total evaluaciones' = COUNTROWS('Consulta1')
		formatString: 0
		lineageTag: bb1602a3-dc5d-4cf8-a2dc-07f8bd421871

	measure 'Margen promedio' = AVERAGE('Consulta1'[margen_libre])
		formatString: #,0.00

	measure 'Deuda promedio' = AVERAGE('Consulta1'[deuda_actual])
		formatString: #,0.00

	measure 'Evaluaciones con deuda' = COUNT('Consulta1'[deuda_actual])
		formatString: 0

	measure 'Cobertura de deuda' = DIVIDE([Evaluaciones con deuda], [Total evaluaciones])
		formatString: 0.0%

	measure 'Ingresos promedio' = AVERAGE('Consulta1'[ingresos_mensuales])
		formatString: #,0.00

